# Python environment
.venv/
__pycache__/
*.pyc

# Model checkpoints (~98 GB). Kept locally — see the ARCHIVE, NEVER DELETE rule in
# CLAUDE.md. Training is deterministic and resume-validated, so these are regenerable.
checkpoints/

# Raw corpora (BabyLM, redistributed by the challenge) and pre-tokenized memmaps.
# Regenerate with the scripts in scripts/ after downloading the corpus.
data/raw/
*.bin
*.zip

# Bulk stdout/stderr from batch training runs (~140 MB).
# Per-checkpoint eval results are kept as logs/**/*.{json,csv,jsonl}.
*.log
*.out
*.err

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc

# Local editor/agent settings
.claude/settings.local.json
