# Python environment — platform-specific binaries, rebuild from requirements.txt
.venv/
__pycache__/
*.pyc

# Model checkpoints (~98 GB). Far beyond any remote's limits. Kept locally under
# the ARCHIVE, NEVER DELETE rule in CLAUDE.md; training is deterministic and
# resume-validated, so these are regenerable rather than lost.
checkpoints/

# Raw BabyLM corpora (~910 MB). Excluded for two independent reasons:
#   1. babylm_data.zip (241 MB) and babylm_100M/open_subtitles.train (159 MB)
#      each exceed GitHub's 100 MB hard per-file limit, so a push is rejected.
#   2. Third-party corpus with mixed upstream licences (OpenSubtitles, BNC,
#      Wikipedia, Gutenberg, CBT) — fetched, not redistributed.
# Rebuild with scripts/prepare_babylm.py, then scripts/prepare_skills.py.
data/raw/
