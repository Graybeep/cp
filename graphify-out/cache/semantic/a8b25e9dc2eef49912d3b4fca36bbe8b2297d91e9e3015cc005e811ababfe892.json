{"nodes": [{"id": "notes_ml_primer_for_this_project_md", "label": "ML Primer for This Project", "file_type": "document", "source_file": "notes/ml-primer-for-this-project.md.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Math-background-assumed primer mapping ML vocabulary (loss, LR, Adam, tokens, embeddings, attention, layers, checkpoints, perplexity, activation patching, ablation, CKA) onto the exact pipeline pieces being built, so the researcher can sanity-check outputs without writing code."}, {"id": "notes_ml_primer_for_this_project_md_perplexity", "label": "Perplexity as safeguard metric", "file_type": "concept", "source_file": "notes/ml-primer-for-this-project.md.pdf", "source_location": "Section 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perplexity = e^(average loss), how surprised the model is by real text. It is the safeguard metric: if an intervention raises skill accuracy but perplexity gets much worse, that is the catastrophic-forgetting pitfall, not real reopening."}, {"id": "notes_ml_primer_for_this_project_md_embedding_layer", "label": "Embedding layer (token ID -> vector lookup)", "file_type": "concept", "source_file": "notes/ml-primer-for-this-project.md.pdf", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup table from token ID to vector, shaped by training to encode meaning - which is why resetting it (intervention #1) is such a big deal: it wipes everything the model learned about representing every token."}, {"id": "notes_ml_primer_for_this_project_md_activation_patching", "label": "Activation patching (primer definition)", "file_type": "concept", "source_file": "notes/ml-primer-for-this-project.md.pdf", "source_location": "Section 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running the